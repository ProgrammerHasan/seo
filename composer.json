{
  "name": "programmerhasan/seo",
  "description": "Lightweight, modern SEO toolkit for Laravel, Inertia, Schema.org, sitemaps, robots, OpenGraph, Twitter Cards and optional AI SEO.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "seo",
    "inertia",
    "opengraph",
    "twitter-cards",
    "json-ld",
    "schema-org",
    "sitemap",
    "robots",
    "ai-seo"
  ],
  "authors": [
    {
      "name": "Programmer Hasan",
      "email": "programmerhasan.s@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.18",
    "nunomaduro/collision": "^7.0|^8.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "pestphp/pest": "^2.0|^3.0",
    "pestphp/pest-plugin-laravel": "^2.0|^3.0",
    "phpstan/phpstan": "^1.10",
    "larastan/larastan": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "ProgrammerHasan\\Seo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProgrammerHasan\\Seo\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ProgrammerHasan\\Seo\\SeoServiceProvider"
      ],
      "aliases": {
        "Seo": "ProgrammerHasan\\Seo\\Facades\\Seo"
      }
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage",
    "format": "vendor/bin/pint",
    "format:test": "vendor/bin/pint --test",
    "analyse": "vendor/bin/phpstan analyse",
    "ci": [
      "@format:test",
      "@analyse",
      "@test"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
